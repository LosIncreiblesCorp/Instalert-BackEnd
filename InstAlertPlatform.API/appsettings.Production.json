{
  "ConnectionStrings": {
    "DefaultConnection": "server=%DATABASE_URL%;user=%DATABASE_USER%;password=%DATABASE_PASSWORD%;database=%DATABASE_SCHEMA%;"
  },
  "Demo": {
    "Enabled": true
  },
  "DevelopmentData": {
    "SeedOnStartup": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Workers": {
    "Enabled": true
  },
  "Email": {
    "Enabled": true,
    "FromName": "InstAlert"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Documentation": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
